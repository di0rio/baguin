# Copie para .env (o servidor carrega .env sozinho). Os valores abaixo servem para desenvolvimento local.

# Porta do servidor (Colyseus + API)
PORT=2567

# Origem do app web (Vite). Usada em trustedOrigins do Better Auth e na checagem do header Origin
# das requisições de escrita (POST/PUT/DELETE) em /api: origem diferente leva 403.
WEB_ORIGIN=http://localhost:5173
# URL pública que o navegador enxerga. Em dev o Vite faz proxy de /api, então é a do web.
# Callbacks sociais: ${BETTER_AUTH_URL}/api/auth/callback/<provedor>
BETTER_AUTH_URL=http://localhost:5173
# Assina sessões e ingressos. OBRIGATÓRIO em produção, com valor próprio (mínimo 32 caracteres): o servidor não sobe com o padrão.
BETTER_AUTH_SECRET=dev-secret-troque-em-producao-0123456789abcdef

# Login de desenvolvimento (e-mail + senha). Deve ser false/ausente em produção: com true o servidor não sobe em produção.
AUTH_DEV_LOGIN=true

# Banco. Sem DATABASE_URL usa PGlite em apps/server/.data/pglite (sem serviço externo).
# DATABASE_URL=postgres://usuario:senha@host:5432/baguin

# Provedores sociais: só aparecem se as duas variáveis do provedor existirem.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# LiveKit. Dev: scripts/livekit-dev.sh (livekit-server --dev) com estas chaves.
# Em produção LIVEKIT_API_KEY e LIVEKIT_API_SECRET devem ser definidos e diferentes de devkey/secret: o servidor não sobe com os de dev.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
