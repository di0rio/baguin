{
  "name": "baguin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n app,livekit -c blue,magenta \"bun run dev:app\" \"bun run livekit\"",
    "dev:app": "bun run --filter '@baguin/*' dev",
    "livekit": "bash scripts/livekit-dev.sh",
    "typecheck": "bun run --filter '@baguin/*' typecheck",
    "test": "bun run --filter '@baguin/*' test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
